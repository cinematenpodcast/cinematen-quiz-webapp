{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/layout/**",
              "components/media/**",
              "components/navigation/**",
              "image-slot.js",
              "ui_kits/website-mobile/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Rubik|Rubik Mono One))/i]",
        "message": "Font not provided by the design system. Available: Rubik, Rubik Mono One."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|badge|title|excerpt|meta|variant|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, badge, title, excerpt, meta, variant, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|overlay|row)$/]",
        "message": "<ArticleCard> variant must be one of 'default' | 'overlay' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, kind, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:category|review|blog|retro|live)$/]",
        "message": "<Badge> kind must be one of 'category' | 'review' | 'blog' | 'retro' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|pill|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, pill, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|spotify|apple)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'spotify' | 'apple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: heading, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|linkIcons|activeIndex|partnerLabel|partnerLogo|onLinkClick|mobileCopyright|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: logo, links, linkIcons, activeIndex, partnerLabel, partnerLogo, onLinkClick, mobileCopyright."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|eyebrowColor|title|description|cta|key|ref|className|style|children)$/]",
        "message": "<HeroSlide> doesn't accept that prop. Declared props: image, eyebrow, eyebrowColor, title, description, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|totalPages|onChange|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, totalPages, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PodcastCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|variant|ctaLabel|icon|key|ref|className|style|children)$/]",
        "message": "<PodcastCallout> doesn't accept that prop. Declared props: title, description, variant, ctaLabel, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PodcastCallout'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:banner|inline)$/]",
        "message": "<PodcastCallout> variant must be one of 'banner' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PodcastPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:episodeTitle|progress|currentTime|totalTime|key|ref|className|style|children)$/]",
        "message": "<PodcastPlayer> doesn't accept that prop. Declared props: episodeTitle, progress, currentTime, totalTime."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
